{
  "name": "@hakimedes/dsh-easyremote",
  "version": "0.2.8",
  "description": "Local-first DSH EasyRemote installer, Hub and Cloudflare Tunnel supervisor",
  "type": "module",
  "bin": {
    "dsh-easyremote": "dist/cli.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "runtime",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node node_modules/pnpm/bin/pnpm.cjs -C ../hub build && node node_modules/pnpm/bin/pnpm.cjs -C ../dsh-plugin build && tsc -p tsconfig.json && node scripts/build-runtime.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.0",
    "cross-spawn": "^7.0.6",
    "fastify": "^5.12.1",
    "jose": "^6.2.10",
    "pnpm": "11.24.0",
    "pnpm-v10": "npm:pnpm@10.34.5",
    "pnpm-v11": "npm:pnpm@11.24.0",
    "qrcode": "^1.5.4",
    "uuid": "^14.0.2",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hakimedes/dsh-easyremote.git"
  },
  "homepage": "https://github.com/hakimedes/dsh-easyremote#readme",
  "bugs": {
    "url": "https://github.com/hakimedes/dsh-easyremote/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
